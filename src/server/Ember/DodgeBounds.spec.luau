local Bounds = require("./DodgeBounds")
assert(Bounds.inside(0, 150, 0, 150, 29, 24))
assert(Bounds.inside(0, 150, 26, 171, 29, 24))
assert(not Bounds.inside(0, 150, 26.1, 171, 29, 24))
assert(not Bounds.inside(0, 150, 0, 172, 29, 24))
assert(not Bounds.inside(0, 150, -28, 150, 29, 24))
assert(not Bounds.inside(0, 150, 0, 150, 2, 24))
assert(not Bounds.inside(0, 150, math.huge, 150, 29, 24))
assert(not Bounds.inside(0, 150, 0/0, 150, 29, 24))
print("Ember safe dodge landing: PASS")
