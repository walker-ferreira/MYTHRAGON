local Dodge = require("./DodgeState")
local a, b = Dodge.new(), Dodge.new()
assert(a:use(10))
assert(not a:use(11))
assert(not a:use(12.99))
assert(a:use(13))
assert(b:use(11), "Other encounters must not inherit cooldown")
assert(not a:use(0 / 0), "NaN invalid")
assert(not a:use(math.huge), "Infinity invalid")
assert(not a:use(-math.huge), "Negative infinity invalid")
print("Ember dodge cooldown: PASS")
