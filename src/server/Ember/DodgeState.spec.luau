local Dodge = require("./DodgeState")
local a, b = Dodge.new(), Dodge.new()
assert(not a:isEvading(10))
assert(a:use(10))
assert(a:isEvading(10))
assert(a:isEvading(10.44))
assert(not a:isEvading(10 + Dodge.EVASION_WINDOW))
assert(not a:isEvading(9.99))
assert(not b:isEvading(10.1), "Protection is per encounter")
assert(not a:use(11))
assert(not a:isEvading(11), "A rejected dodge cannot renew protection")
assert(not a:use(12.99))
assert(a:use(13))
assert(b:use(11), "Other encounters must not inherit cooldown")
assert(not a:use(0 / 0), "NaN invalid")
assert(not a:use(math.huge), "Infinity invalid")
assert(not a:use(-math.huge), "Negative infinity invalid")
print("Ember dodge cooldown: PASS")
