local State = require("./ExplorationState")
local p = State.new()
assert(p.total == 0)
assert(p:mark("latunia") and p.total == 1)
assert(not p:mark("latunia") and p.total == 1)
assert(not p:mark("credits") and p.total == 1)
p:hydrate({ gelo = true, selva = true, deserto = false, vulcanica = "true" })
assert(p.total == 3 and p.visited.latunia and p.visited.gelo and p.visited.selva)
p:hydrate({ latunia = true, gelo = true, deserto = true, vulcanica = true })
assert(p.total == 5, "Load after first visit must only add progress")
assert(State.new().total == 0, "Other players are independent")
print("Exploration panel state: PASS")
