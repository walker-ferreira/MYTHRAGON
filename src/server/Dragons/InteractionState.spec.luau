local State = require("./InteractionState")
local state = State.new()
local a, b = {}, {}
assert(not state:begin(a, 0, 12.01, true), "server reach")
assert(not state:begin(a, 0, 1, false), "dead character")
assert(not state:begin(a, 0, -1, true))
assert(not state:begin(a, 0, 0 / 0, true))
assert(not state:begin(a, math.huge, 1, true))
assert(not state:begin(nil, 0, 1, true))
local ticket, first = state:begin(a, 0, 12, true)
assert(ticket and first, "inclusive boundary, first interaction")
assert(not state:begin(a, 3, 1, true), "pending callback serialized")
assert(state:finish(a, ticket, true))
assert(not state:finish(a, ticket, true), "ticket consumed once")
assert(not state:begin(a, 2.99, 1, true), "cooldown")
local repeatTicket, repeatFirst = state:begin(a, 3, 1, true)
assert(repeatTicket and not repeatFirst, "repeat dialogue without second callback")
assert(not state:finish(a, ticket, true), "old ticket cannot consume a newer attempt")
assert(state:finish(a, repeatTicket, true))
local bTicket, bFirst = state:begin(b, 3, 1, true)
assert(bTicket and bFirst, "second player does not inherit progress")
assert(state:finish(b, bTicket, false))
local retry, retryFirst = state:begin(b, 6, 1, true)
assert(retry and retryFirst, "failed callback can retry")
state:remove(b)
assert(not state:finish(b, retry, true), "disconnect while callback pending")
local reconnect, reconnectFirst = state:begin(b, 7, 1, true)
assert(reconnect and reconnectFirst, "new session starts clean")
state:clear()
assert(not state:finish(b, reconnect, true), "destroy invalidates pending tickets")
assert(next(state.players) == nil)
print("Varkhion interaction rules: PASS")
