local P = require("./BreathPattern")
local x, z = P.target(0, 150, 8, 155, 29, 24)
assert(x == 8 and z == 155, "Breath should target player position")
x, z = P.target(0, 150, 999, -999, 29, 24)
assert(x + P.HALF_WIDTH == 29 and z - P.HALF_WIDTH == 126,
    "The entire warning must stay on the arena floor")
assert(P.hits(5, 7, 16, 18, 8), "Telegraph boundaries are inclusive")
assert(not P.hits(5, 7, 16.1, 18, 0))
assert(not P.hits(5, 7, 5, 7, 8.1))
assert(not P.hits(5, 7, 5, -5, 0))
assert(P.target(0, 150, 0/0, 150, 29, 24) == nil)
assert(P.target(0, 150, math.huge, 150, 29, 24) == nil)
assert(P.target(0, 150, 0, 150, 10, 24) == nil)
assert(not P.hits(0/0, 0, 0, 0, 0))
assert(not P.hits(0, 0, 0, math.huge, 0))
print("Ember targeted telegraph: PASS")
